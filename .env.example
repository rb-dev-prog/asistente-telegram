# Token de Telegram entregado por @BotFather
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui

# API Key de Gemini desde Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Zona horaria del usuario (por ejemplo: America/Caracas, America/Argentina/Buenos_Aires, etc.)
TIMEZONE=America/Caracas

# Whitelist de IDs de Telegram autorizados (separados por coma, ej: 12345678,98765432). Vacío = permite a todos.
ALLOWED_USER_IDS=
